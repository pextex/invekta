# Razvojna konfiguracija: kopirajte kao .env; ne čuvajte .env u Git-u.
POSTGRES_PASSWORD=replace-with-a-long-random-development-password
DATABASE_URL=postgresql+psycopg://crm:replace-with-a-long-random-development-password@127.0.0.1:5432/crm
# Za HTTP samo u lokalnom privatnom razvoju. Za javni HTTPS mora biti true.
CRM_COOKIE_SECURE=false
CRM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Demo seed čita ovu promenljivu iz procesa, ne automatski iz .env.
# CRM_DEMO_PASSWORD se ne čuva u Git-u i mora imati najmanje 12 znakova.

# Invekta AI: ključ CRM_GEMINI_API_KEY obezbedite samo kroz serverski secret store.
# Ne koristiti VITE_ prefiks niti stare CRM_AI_API_KEY / CRM_GROQ_API_KEY ključeve.
CRM_GEMINI_MODEL=gemini-3.1-flash-lite
# Podrazumevano bez spoljnog poziva (lokalni šabloni). Uključiti tek uz Gemini Free ključ.
CRM_AI_ENABLED=false
