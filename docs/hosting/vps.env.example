# Save as .env.production on the VPS, permissions 600. Do not share this file.
# Use 64 hex characters from: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
CRM_ALLOWED_ORIGINS=https://crm.example.rs
CRM_COOKIE_SECURE=true
# Enable after entering the real Gemini key and checking available quota.
CRM_AI_ENABLED=false
CRM_GEMINI_API_KEY=
CRM_GEMINI_MODEL=gemini-3.1-flash-lite
