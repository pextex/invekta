{
  "name": "LUU × Invekta × Cenobots CRM",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22", "installYarnUsingApt": false },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "python scripts/dev_tools.py",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "CRM — Live Preview",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "8000": { "onAutoForward": "ignore" },
    "5432": { "onAutoForward": "ignore" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" }
}
