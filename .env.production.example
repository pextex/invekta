# Copy to .env.production on the company server. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://CRM_USER:REPLACE_PASSWORD@DATABASE_HOST:5432/CRM_DATABASE
CRM_COOKIE_SECURE=true
CRM_ALLOWED_ORIGINS=https://crm.example.rs
CRM_AI_ENABLED=true
CRM_GEMINI_API_KEY=REPLACE_WITH_EXISTING_SERVER_KEY
CRM_GEMINI_MODEL=gemini-3.1-flash-lite
